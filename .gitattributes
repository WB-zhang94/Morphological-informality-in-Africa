# Auto detect text files and perform LF normalization
* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf
*.R text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.gitkeep text eol=lf
*.csv text eol=lf
*.geojson text eol=lf
*.tif binary
*.tiff binary
*.rds binary
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.xls binary
*.xlsx binary
*.gpkg binary
data/input/**/*_building_presence.tif filter=lfs diff=lfs merge=lfs -text
data/input/**/*_building_height.tif filter=lfs diff=lfs merge=lfs -text
data/input/**/*_ndvi.tif filter=lfs diff=lfs merge=lfs -text
data/input/**/*_ndbi.tif filter=lfs diff=lfs merge=lfs -text
